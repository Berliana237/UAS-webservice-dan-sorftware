# ==== Rangkai: daftar environment variable ====
# scripts/setup.js (dijalankan otomatis oleh run.bat) membuat .env dengan nilai acak.
# File ini hanya berisi PLACEHOLDER. Jangan pernah commit secret asli.

NODE_ENV=development
# URL publik gateway, dipakai untuk redirect OAuth2 dan CORS
PUBLIC_URL=http://localhost:8080
# Origin lain yang boleh memanggil API dari browser (dipisah koma)
CORS_ORIGINS=http://localhost:8080,https://localhost:8443
# Geser semua port (dipakai stack pengujian agar tidak bentrok dengan stack demo)
PORT_OFFSET=0
# Folder database SQLite dan folder sertifikat mTLS
DATA_DIR=data
CERT_DIR=certs
# 1 bila gateway berada di belakang proxy platform (Render), agar X-Forwarded-For dipercaya
TRUST_PROXY=0

# ---- Secret (wajib, isi dengan nilai acak) ----
# AES-256-GCM untuk kolom sensitif (nama, NIK, kontak), 32 byte dalam base64
PII_KEY_BASE64=<base64-32-byte>
# HMAC untuk blind index email (pencarian tanpa membuka enkripsi)
BLIND_INDEX_KEY=<random-hex>
# Tanda tangan webhook payment gateway (HMAC-SHA256)
WEBHOOK_SECRET=<random-hex>
# Client Credentials antar service
SVC_PAYMENT_CLIENT_SECRET=<random-hex>
SVC_BOOKING_CLIENT_SECRET=<random-hex>
# Client Credentials milik partner demo
PARTNER_DEMO_CLIENT_SECRET=<random-hex>
# Password akun demo hasil seed (hanya lingkungan demo/pengujian)
SEED_USER_PASSWORD=<password-demo>

# ---- Kebijakan bisnis ----
# TTL lock kursi per segmen (detik). Rancangan: sekitar 10 menit.
LOCK_TTL_SECONDS=600
# Masa berlaku access token (detik). Rancangan: sekitar 15 menit.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---- Rate limit per menit ----
RATE_GLOBAL_PER_MIN=1200
RATE_LOGIN_PER_MIN=10
RATE_REGISTER_PER_MIN=20
RATE_TOKEN_PER_MIN=120
RATE_LOCK_PER_MIN=30
RATE_PAYMENT_PER_MIN=30
RATE_GRAPHQL_PER_MIN=600
RATE_PUBLIC_READ_PER_MIN=600

# ---- Message broker ----
BROKER_MAX_ATTEMPTS=4
BROKER_VISIBILITY_MS=15000

# ---- Lain-lain ----
# 1 = gateway pembayaran simulasi aktif (lingkungan demo, tanpa data kartu asli)
MOCK_GATEWAY=1
# Jumlah akun load test yang di-seed (0 = tidak ada)
LOAD_USERS=0
